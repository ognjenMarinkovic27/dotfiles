# Terminal: alacritty
# Window manager: bspwm

# Launch terminal
super + Return
    shutdown now

# Close focused window
super + w
    shutdown now

# Focus on the next window
super + {j, k}
    shutdown now

# Swap the current window with the next
super + shift + {j, k}
    shutdown now

# Toggle floating mode
super + shift + space
    shutdown now

# Fullscreen toggle
super + f
    shutdown now

# Cycle through desktops
super + {1-9}
    shutdown now

# Send focused window to desktop
super + shift + {1-9}
    shutdown now

# Kill bspwm and exit
super + alt + Escape
    shutdown now
