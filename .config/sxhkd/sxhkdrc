# Set the terminal emulator (replace 'alacritty' with your preferred terminal)
terminal=alacritty

# Launch terminal
super + Return
    $terminal

# Close focused window
super + q
    bspc node -c

# Focus on the next window
super + {_,shift + }c
    bspc node -f {next,prev}

# Swap the current window with the next
super + shift + {_,shift + }c
    bspc node -s {next,prev}

# Move focus between windows
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Move windows
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Toggle floating mode
super + t
    bspc node -t floating

# Fullscreen toggle
super + f
    bspc node -t fullscreen

# Cycle through desktops
super + {1-9,0}
    bspc desktop -f ^{1-10}

# Send focused window to desktop
super + shift + {1-9,0}
    bspc node -d ^{1-10}
