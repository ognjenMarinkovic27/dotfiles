# Terminal: alacritty
# Window manager: bspwm

# Launch terminal
super + Return
    alacritty

# Close focused window
super + w
    bspc node -c

# Focus on the next window
super + {j, k}
    bspc node -f {next,prev}.local.!floating

# Swap the current window with the next
super + shift + {j, k}
    bspc node -s {next,prev}.local.!floating

# Toggle floating mode
super + shift + space
    bspc node -t \~floating

# Fullscreen toggle
super + f
    bspc node -t \~fullscreen

# Cycle through desktops
super + {1-9}
    bspc desktop -f ^{1-9}

# Send focused window to desktop
super + shift + {1-9}
    bspc node -d ^{1-9}

# Kill bspwm and exit
super + alt + Escape
    bspc quit
